{
  "name": "@muster-code/builtin",
  "displayName": "Muster",
  "description": "The Muster layer of Muster Code: Codex-first agent chat, pinned threads, live diffs, the board.",
  "version": "0.1.0",
  "publisher": "muster",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.126.0"
  },
  "main": "./dist-ext/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantPrivate",
    "chatParticipantAdditions",
    "chatProvider",
    "chatSessionsProvider",
    "languageModelThinkingPart",
    "languageModelCapabilities",
    "inlineCompletionsAdditions",
    "mappedEditsProvider",
    "mcpServerDefinitions",
    "terminalDataWriteEvent"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "muster.agent",
        "name": "muster",
        "fullName": "Muster",
        "description": "Codex-first agent for this workspace",
        "isDefault": true,
        "locations": [
          "panel",
          "editor",
          "terminal",
          "notebook"
        ],
        "modes": [
          "ask",
          "edit",
          "agent"
        ]
      }
    ],
    "chatSessions": [
      {
        "type": "codex",
        "name": "codex",
        "displayName": "Codex threads",
        "description": "Your Codex threads, by the app's own names",
        "when": "true"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "muster",
        "displayName": "Muster (Codex · Claude · more)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "muster-agent",
          "title": "Agent",
          "icon": "resources/agent.svg"
        }
      ]
    },
    "views": {
      "muster-agent": [
        {
          "id": "muster.agent.pane",
          "type": "webview",
          "name": "New Agent",
          "icon": "resources/agent.svg",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "muster.agent.new",
        "title": "New Agent",
        "icon": "$(add)"
      },
      {
        "command": "muster.agent.history",
        "title": "Agent History",
        "icon": "$(history)"
      },
      {
        "command": "muster.agent.more",
        "title": "More",
        "icon": "$(ellipsis)"
      },
      {
        "command": "muster.agent.stop",
        "title": "Stop Agent"
      },
      {
        "command": "muster.agent.maximize",
        "title": "Maximize Chat"
      },
      {
        "command": "muster.thread.resume",
        "title": "Muster: Resume Codex Thread"
      },
      {
        "command": "muster.debug.extensionState",
        "title": "Muster: Show Extension State"
      },
      {
        "command": "muster.edit.accept",
        "title": "Accept Change"
      },
      {
        "command": "muster.edit.reject",
        "title": "Reject Change"
      },
      {
        "command": "muster.edit.acceptFile",
        "title": "Accept File"
      },
      {
        "command": "muster.edit.rejectFile",
        "title": "Reject File"
      },
      {
        "command": "muster.edit.acceptAll",
        "title": "Accept All Changes",
        "icon": "$(check-all)"
      },
      {
        "command": "muster.edit.rejectAll",
        "title": "Reject All Changes",
        "icon": "$(discard)"
      },
      {
        "command": "muster.edit.next",
        "title": "Next Change"
      },
      {
        "command": "muster.edit.prev",
        "title": "Previous Change"
      },
      {
        "command": "muster.edit.hunk",
        "title": "Decide a Change"
      },
      {
        "command": "muster.edit.file",
        "title": "Decide a File"
      },
      {
        "command": "muster.edit.go",
        "title": "Go to Change"
      },
      {
        "command": "muster.agent.board",
        "title": "Agent Board",
        "icon": "$(layout)"
      },
      {
        "command": "muster.agent.mode",
        "title": "Cycle Agent Mode"
      },
      {
        "command": "muster.cmdk",
        "title": "Edit with Agent"
      },
      {
        "command": "muster.plan.preview",
        "title": "Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "muster.plan.build",
        "title": "Build",
        "icon": "$(play)"
      },
      {
        "command": "muster.cmdk.submit",
        "title": "Submit ⌘K Prompt"
      },
      {
        "command": "muster.agent.plugins",
        "title": "Codex Plugins and MCP Servers"
      },
      {
        "command": "muster.cmdk.terminal",
        "title": "Terminal: Write Command with Agent"
      },
      {
        "command": "muster.review.open",
        "title": "Review Changes"
      },
      {
        "command": "muster.review.git",
        "title": "Review Changes with Agent",
        "icon": "$(sparkle)"
      },
      {
        "command": "muster.completions.toggle",
        "title": "Toggle Muster Tab"
      },
      {
        "command": "muster.plan.model",
        "title": "Model for Build",
        "icon": "$(sparkle)"
      },
      {
        "command": "muster.plan.previewMenu",
        "title": "Plan View"
      },
      {
        "command": "muster.plan.buildMenu",
        "title": "Build Options"
      },
      {
        "command": "muster.agent.tab",
        "title": "Activate Agent Tab"
      },
      {
        "command": "muster.agent.closeTab",
        "title": "Close Agent Tab"
      },
      {
        "command": "muster.edit.nextFile",
        "title": "Review Next File"
      },
      {
        "command": "muster.edit.prevFile",
        "title": "Review Previous File"
      },
      {
        "command": "muster.agent.addSelection",
        "title": "Add Selection to Chat"
      },
      {
        "command": "muster.settings.open",
        "title": "Muster Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "muster.browser.openTab",
        "title": "Open Browser",
        "icon": "$(globe)"
      },
      {
        "command": "muster.browser.reloadActive",
        "title": "Browser: Reload"
      },
      {
        "command": "muster.browser.pickActive",
        "title": "Browser: Select Element for Chat"
      },
      {
        "command": "muster.completions.menu",
        "title": "Muster Tab: Options"
      },
      {
        "command": "muster.completions.snooze",
        "title": "Muster Tab: Snooze"
      },
      {
        "command": "muster.review.keepFile",
        "title": "Keep File",
        "icon": "$(check)"
      },
      {
        "command": "muster.review.undoFile",
        "title": "Undo File",
        "icon": "$(discard)"
      },
      {
        "command": "muster.review.toggleLayout",
        "title": "Review: Inline / Side by side",
        "icon": "$(split-horizontal)"
      }
    ],
    "configuration": {
      "title": "Muster",
      "properties": {
        "muster.codex.model": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "description": "Default Codex model for new threads."
        },
        "muster.codex.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "default": "medium",
          "description": "Codex reasoning effort (the app's Effort setting)."
        },
        "muster.completions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Muster Tab: inline completions from Codex as you pause typing. Uses your ChatGPT plan; off by default."
        },
        "muster.modes": {
          "type": "array",
          "default": [],
          "description": "Custom agent modes: objects with id, name, icon, placeholder, prompt. Built-in modes: agent, plan, ask, kanban.",
          "items": {
            "type": "object"
          }
        },
        "muster.claude.models": {
          "type": "array",
          "default": [
            "claude-fable-5-1",
            "claude-opus-5",
            "claude-sonnet-5",
            "claude-haiku-4-5-20251001"
          ],
          "description": "Claude models offered in the model picker (run through Claude Code on your Claude subscription).",
          "items": {
            "type": "string"
          }
        },
        "muster.docs": {
          "type": "array",
          "default": [],
          "description": "Docs for the @Docs mention: [{\"name\":\"React\",\"url\":\"https://react.dev/reference\"}]. Fetched once and cached under .muster/docs.",
          "items": {
            "type": "object"
          }
        },
        "muster.review.onCommit": {
          "type": "boolean",
          "default": false,
          "description": "After each commit, review it for issues in the Agent pane (read-only turn)."
        },
        "muster.browser.location": {
          "type": "string",
          "enum": [
            "editor",
            "pane"
          ],
          "default": "editor",
          "description": "Where Open Browser (⇧⌘B) puts the browser: an editor tab beside the code (Cursor's browser editor) or a tab in the Agent pane."
        },
        "muster.rules.disabled": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Rule names (without extension) that are not sent to the agent. Managed from Muster Settings → Rules."
        },
        "muster.mcp.disabled": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "MCP servers switched off for Muster Code turns (passed as mcp_servers.<name>.enabled=false; ~/.codex/config.toml is untouched). Managed from Muster Settings → MCP."
        },
        "muster.completions.disabledLanguages": {
          "type": "array",
          "default": [
            "markdown",
            "plaintext"
          ],
          "items": {
            "type": "string"
          },
          "description": "Languages Muster Tab stays quiet in (Cursor's default: markdown, plaintext)."
        },
        "muster.completions.nextEdit": {
          "type": "boolean",
          "default": true,
          "description": "Next-edit prediction: after an edit, Muster Tab may suggest the change it implies elsewhere in the file as an inline edit (Tab jumps and accepts)."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "muster.agent.new",
          "when": "view == muster.agent.pane",
          "group": "navigation@1"
        },
        {
          "command": "muster.agent.history",
          "when": "view == muster.agent.pane",
          "group": "navigation@2"
        },
        {
          "command": "muster.agent.more",
          "when": "view == muster.agent.pane",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "muster.plan.preview",
          "when": "resourceFilename =~ /\\\\.plan\\\\.md$/",
          "group": "navigation@1"
        },
        {
          "command": "muster.plan.build",
          "when": "resourceFilename =~ /\\\\.plan\\\\.md$/",
          "group": "navigation@3"
        },
        {
          "command": "muster.plan.model",
          "when": "resourceFilename =~ /\\\\.plan\\\\.md$/",
          "group": "navigation@2"
        },
        {
          "command": "muster.edit.acceptAll",
          "when": "activeEditor == 'workbench.editor.multiDiffEditor' && muster.liveEdit",
          "group": "navigation@1"
        },
        {
          "command": "muster.edit.rejectAll",
          "when": "activeEditor == 'workbench.editor.multiDiffEditor' && muster.liveEdit",
          "group": "navigation@2"
        },
        {
          "command": "muster.review.toggleLayout",
          "when": "activeEditor == 'workbench.editor.multiDiffEditor'",
          "group": "navigation@3"
        }
      ],
      "scm/title": [
        {
          "command": "muster.review.git",
          "when": "scmProvider == git",
          "group": "navigation@1"
        }
      ],
      "multiDiffEditor/resource/title": [
        {
          "command": "muster.review.keepFile",
          "when": "muster.liveEdit",
          "group": "navigation@1"
        },
        {
          "command": "muster.review.undoFile",
          "when": "muster.liveEdit",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "muster.agent.new",
        "key": "shift+cmd+l",
        "mac": "shift+cmd+l"
      },
      {
        "command": "muster.agent.maximize",
        "key": "alt+cmd+e",
        "mac": "alt+cmd+e"
      },
      {
        "command": "muster.edit.accept",
        "key": "ctrl+shift+y",
        "mac": "cmd+y",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.reject",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.acceptFile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.rejectFile",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+backspace",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.agent.mode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "focusedView == muster.agent.pane"
      },
      {
        "command": "muster.cmdk",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "muster.plan.build",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "resourceFilename =~ /\\\\.plan\\\\.md$/ && editorTextFocus"
      },
      {
        "command": "muster.cmdk.terminal",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "terminalFocus"
      },
      {
        "command": "muster.edit.next",
        "key": "alt+j",
        "mac": "alt+j",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.prev",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.nextFile",
        "key": "alt+l",
        "mac": "alt+l",
        "when": "muster.liveEdit"
      },
      {
        "command": "muster.edit.prevFile",
        "key": "alt+h",
        "mac": "alt+h",
        "when": "muster.liveEdit"
      },
      {
        "command": "muster.agent.addSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "muster.agent.mode",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus || focusedView == muster.agent.pane"
      },
      {
        "command": "muster.browser.openTab",
        "key": "ctrl+shift+b",
        "mac": "shift+cmd+b"
      },
      {
        "command": "muster.browser.reloadActive",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "muster.browserActive"
      },
      {
        "command": "muster.browser.pickActive",
        "key": "ctrl+shift+c",
        "mac": "shift+cmd+c",
        "when": "muster.browserActive"
      },
      {
        "command": "muster.browser.openTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "muster.browserActive"
      },
      {
        "command": "editor.action.inlineSuggest.acceptNextWord",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "inlineSuggestionVisible && !editorReadonly"
      }
    ],
    "customEditors": [
      {
        "viewType": "muster.planEditor",
        "displayName": "Plan",
        "selector": [
          {
            "filenamePattern": "*.plan.md"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@musterhq/core": "link:../../../muster/packages/core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.105.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
