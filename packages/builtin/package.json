{
  "name": "@muster-code/builtin",
  "displayName": "Muster",
  "description": "The Muster layer of Muster Code: Codex-first agent chat, pinned threads, live diffs, the board.",
  "version": "0.1.0",
  "publisher": "muster",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.126.0"
  },
  "main": "./dist-ext/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantPrivate",
    "chatParticipantAdditions",
    "chatProvider",
    "chatSessionsProvider",
    "languageModelThinkingPart",
    "languageModelCapabilities",
    "inlineCompletionsAdditions",
    "mappedEditsProvider",
    "mcpServerDefinitions"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "muster.agent",
        "name": "muster",
        "fullName": "Muster",
        "description": "Codex-first agent for this workspace",
        "isDefault": true,
        "locations": [
          "panel",
          "editor",
          "terminal",
          "notebook"
        ],
        "modes": [
          "ask",
          "edit",
          "agent"
        ]
      }
    ],
    "chatSessions": [
      {
        "type": "codex",
        "name": "codex",
        "displayName": "Codex threads",
        "description": "Your Codex threads, by the app's own names",
        "when": "true"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "muster",
        "displayName": "Muster (Codex \u00b7 Claude \u00b7 more)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "muster-agent",
          "title": "Agent",
          "icon": "resources/agent.svg"
        }
      ]
    },
    "views": {
      "muster-agent": [
        {
          "id": "muster.agent.pane",
          "type": "webview",
          "name": "New Agent",
          "icon": "resources/agent.svg",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "muster.agent.new",
        "title": "New Agent",
        "icon": "$(add)"
      },
      {
        "command": "muster.agent.history",
        "title": "Agent History",
        "icon": "$(history)"
      },
      {
        "command": "muster.agent.more",
        "title": "More",
        "icon": "$(ellipsis)"
      },
      {
        "command": "muster.agent.stop",
        "title": "Stop Agent"
      },
      {
        "command": "muster.agent.maximize",
        "title": "Maximize Chat"
      },
      {
        "command": "muster.thread.resume",
        "title": "Muster: Resume Codex Thread"
      },
      {
        "command": "muster.debug.extensionState",
        "title": "Muster: Show Extension State"
      },
      {
        "command": "muster.edit.keep",
        "title": "Keep Change"
      },
      {
        "command": "muster.edit.undo",
        "title": "Undo Change"
      },
      {
        "command": "muster.edit.keepAll",
        "title": "Keep All Changes"
      }
    ],
    "configuration": {
      "title": "Muster",
      "properties": {
        "muster.codex.model": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "description": "Default Codex model for new threads."
        },
        "muster.codex.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "default": "medium",
          "description": "Codex reasoning effort (the app's Effort setting)."
        },
        "muster.completions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Inline (Tab) completions."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "muster.agent.new",
          "when": "view == muster.agent.pane",
          "group": "navigation@1"
        },
        {
          "command": "muster.agent.history",
          "when": "view == muster.agent.pane",
          "group": "navigation@2"
        },
        {
          "command": "muster.agent.more",
          "when": "view == muster.agent.pane",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "muster.agent.new",
        "key": "shift+cmd+l",
        "mac": "shift+cmd+l"
      },
      {
        "command": "muster.agent.maximize",
        "key": "alt+cmd+e",
        "mac": "alt+cmd+e"
      },
      {
        "command": "muster.edit.keep",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.undo",
        "key": "cmd+backspace",
        "mac": "cmd+backspace",
        "when": "muster.liveEdit && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@musterhq/core": "link:../../../muster/packages/core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.105.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
