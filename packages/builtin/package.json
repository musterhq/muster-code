{
  "name": "@muster-code/builtin",
  "displayName": "Muster",
  "description": "The Muster layer of Muster Code: Codex-first agent chat, pinned threads, live diffs, the board.",
  "version": "0.1.0",
  "publisher": "muster",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.126.0"
  },
  "main": "./dist-ext/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantPrivate",
    "chatParticipantAdditions",
    "chatProvider",
    "chatSessionsProvider",
    "languageModelThinkingPart",
    "languageModelCapabilities",
    "inlineCompletionsAdditions",
    "mappedEditsProvider",
    "mcpServerDefinitions"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "muster.agent",
        "name": "muster",
        "fullName": "Muster",
        "description": "Codex-first agent for this workspace",
        "isDefault": true,
        "locations": [
          "panel",
          "editor",
          "terminal",
          "notebook"
        ],
        "modes": [
          "ask",
          "edit",
          "agent"
        ]
      }
    ],
    "chatSessions": [
      {
        "type": "codex",
        "name": "codex",
        "displayName": "Codex threads",
        "description": "Your Codex threads, by the app's own names",
        "when": "true"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "muster",
        "displayName": "Muster (Codex \u00b7 Claude \u00b7 more)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "muster-agent",
          "title": "Agent",
          "icon": "resources/agent.svg"
        }
      ]
    },
    "views": {
      "muster-agent": [
        {
          "id": "muster.agent.pane",
          "type": "webview",
          "name": "New Agent",
          "icon": "resources/agent.svg",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "muster.agent.new",
        "title": "New Agent",
        "icon": "$(add)"
      },
      {
        "command": "muster.agent.history",
        "title": "Agent History",
        "icon": "$(history)"
      },
      {
        "command": "muster.agent.more",
        "title": "More",
        "icon": "$(ellipsis)"
      },
      {
        "command": "muster.agent.stop",
        "title": "Stop Agent"
      },
      {
        "command": "muster.agent.maximize",
        "title": "Maximize Chat"
      },
      {
        "command": "muster.thread.resume",
        "title": "Muster: Resume Codex Thread"
      },
      {
        "command": "muster.debug.extensionState",
        "title": "Muster: Show Extension State"
      },
      {
        "command": "muster.edit.accept",
        "title": "Accept Change"
      },
      {
        "command": "muster.edit.reject",
        "title": "Reject Change"
      },
      {
        "command": "muster.edit.acceptFile",
        "title": "Accept File"
      },
      {
        "command": "muster.edit.rejectFile",
        "title": "Reject File"
      },
      {
        "command": "muster.edit.acceptAll",
        "title": "Accept All Changes"
      },
      {
        "command": "muster.edit.rejectAll",
        "title": "Reject All Changes"
      },
      {
        "command": "muster.edit.next",
        "title": "Next Change"
      },
      {
        "command": "muster.edit.prev",
        "title": "Previous Change"
      },
      {
        "command": "muster.edit.hunk",
        "title": "Decide a Change"
      },
      {
        "command": "muster.edit.file",
        "title": "Decide a File"
      },
      {
        "command": "muster.edit.go",
        "title": "Go to Change"
      },
      {
        "command": "muster.agent.board",
        "title": "Agent Board",
        "icon": "$(layout)"
      },
      {
        "command": "muster.agent.mode",
        "title": "Cycle Agent Mode"
      },
      {
        "command": "muster.cmdk",
        "title": "Edit with Agent"
      },
      {
        "command": "muster.plan.preview",
        "title": "Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "muster.plan.build",
        "title": "Build",
        "icon": "$(play)"
      },
      {
        "command": "muster.cmdk.submit",
        "title": "Submit \u2318K Prompt"
      },
      {
        "command": "muster.agent.plugins",
        "title": "Codex Plugins and MCP Servers"
      },
      {
        "command": "muster.cmdk.terminal",
        "title": "Terminal: Write Command with Agent"
      },
      {
        "command": "muster.review.open",
        "title": "Review Changes"
      },
      {
        "command": "muster.review.git",
        "title": "Review Changes Against Branch"
      },
      {
        "command": "muster.completions.toggle",
        "title": "Toggle Muster Tab"
      },
      {
        "command": "muster.plan.model",
        "title": "Model for Build",
        "icon": "$(sparkle)"
      },
      {
        "command": "muster.plan.previewMenu",
        "title": "Plan View"
      },
      {
        "command": "muster.plan.buildMenu",
        "title": "Build Options"
      }
    ],
    "configuration": {
      "title": "Muster",
      "properties": {
        "muster.codex.model": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "description": "Default Codex model for new threads."
        },
        "muster.codex.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "default": "medium",
          "description": "Codex reasoning effort (the app's Effort setting)."
        },
        "muster.completions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Muster Tab: inline completions from Codex as you pause typing. Uses your ChatGPT plan; off by default."
        },
        "muster.modes": {
          "type": "array",
          "default": [],
          "description": "Custom agent modes: objects with id, name, icon, placeholder, prompt. Built-in modes: agent, plan, ask, kanban.",
          "items": {
            "type": "object"
          }
        },
        "muster.claude.models": {
          "type": "array",
          "default": [
            "claude-fable-5-1",
            "claude-opus-5",
            "claude-sonnet-5",
            "claude-haiku-4-5-20251001"
          ],
          "description": "Claude models offered in the model picker (run through Claude Code on your Claude subscription).",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "muster.agent.new",
          "when": "view == muster.agent.pane",
          "group": "navigation@1"
        },
        {
          "command": "muster.agent.history",
          "when": "view == muster.agent.pane",
          "group": "navigation@2"
        },
        {
          "command": "muster.agent.board",
          "when": "view == muster.agent.pane",
          "group": "navigation@3"
        },
        {
          "command": "muster.agent.more",
          "when": "view == muster.agent.pane",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "muster.plan.preview",
          "when": "resourceFilename =~ /\\\\.plan\\\\.md$/",
          "group": "navigation@1"
        },
        {
          "command": "muster.plan.build",
          "when": "resourceFilename =~ /\\\\.plan\\\\.md$/",
          "group": "navigation@3"
        },
        {
          "command": "muster.plan.model",
          "when": "resourceFilename =~ /\\\\.plan\\\\.md$/",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "muster.agent.new",
        "key": "shift+cmd+l",
        "mac": "shift+cmd+l"
      },
      {
        "command": "muster.agent.maximize",
        "key": "alt+cmd+e",
        "mac": "alt+cmd+e"
      },
      {
        "command": "muster.edit.accept",
        "key": "ctrl+shift+y",
        "mac": "cmd+y",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.reject",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.acceptFile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.rejectFile",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+backspace",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.next",
        "key": "alt+f5",
        "mac": "alt+f5",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.edit.prev",
        "key": "shift+alt+f5",
        "mac": "shift+alt+f5",
        "when": "muster.liveEdit && editorTextFocus"
      },
      {
        "command": "muster.agent.mode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "focusedView == muster.agent.pane"
      },
      {
        "command": "muster.cmdk",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "muster.plan.build",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "resourceFilename =~ /\\\\.plan\\\\.md$/ && editorTextFocus"
      },
      {
        "command": "muster.cmdk.terminal",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "terminalFocus"
      }
    ],
    "customEditors": [
      {
        "viewType": "muster.planEditor",
        "displayName": "Plan",
        "selector": [
          {
            "filenamePattern": "*.plan.md"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@musterhq/core": "link:../../../muster/packages/core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.105.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
