{
  "name": "@muster/server",
  "version": "0.2.10",
  "private": true,
  "description": "Muster Server: self-hosted, headless Muster Agent runtime with a web UI, accounts, connectors and the muster-server CLI.",
  "license": "MIT",
  "bin": {
    "muster-server": "bin/muster-server"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --max-old-space-size=1536 --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'tests/*.test.ts'",
    "e2e": "node --max-old-space-size=1536 e2e/run-e2e.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "homepage": "https://github.com/musterhq/muster-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/musterhq/muster-code.git"
  },
  "type": "module"
}
