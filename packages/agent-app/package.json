{
  "name": "@muster/agent-app",
  "version": "0.2.0",
  "private": true,
  "description": "Muster Code standalone agent desktop app (Electron, no Code-OSS extension host).",
  "license": "UNLICENSED",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --max-old-space-size=1536 --experimental-transform-types --test 'tests/*.test.ts'",
    "test:renderer": "node scripts/test-renderer.mjs",
    "rebuild:native": "npx -y @electron/rebuild@4 -f -w node-pty"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shikijs/langs": "4.2.0",
    "@shikijs/themes": "4.2.0",
    "@tanstack/react-virtual": "3.14.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "1.47.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.2.0",
    "ssf": "^0.11.2"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.2",
    "esbuild": "0.28.2",
    "linkedom": "^0.18.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
