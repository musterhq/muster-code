{
  "name": "@muster/agent-app",
  "version": "0.3.17",
  "private": true,
  "description": "Muster Code standalone agent desktop app (Electron, no Code-OSS extension host).",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck:parity": "node scripts/typecheck-parity.mjs",
    "pretest": "node scripts/build-write-helper.mjs",
    "test": "node --max-old-space-size=1536 --experimental-transform-types --import ./tests/pin-device-platform.mjs --test 'tests/*.test.ts' 'tests/*.test.cjs'",
    "test:renderer": "node scripts/test-renderer.mjs",
    "test:electron": "node scripts/test-electron.mjs",
    "test:server-e2e": "node scripts/test-server-e2e.mjs",
    "rebuild:native": "node scripts/postinstall.mjs --force",
    "postinstall": "node scripts/postinstall.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "package": "node scripts/package-release.mjs",
    "shots": "node --max-old-space-size=1536 scripts/readme-shots/shoot.mjs",
    "package:linux": "node scripts/build.mjs && electron-builder --linux --publish never -c.productName=muster-agent",
    "package:win": "node scripts/build.mjs && electron-builder --win --publish never"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@napi-rs/canvas": "^1.0.13",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@tanstack/react-virtual": "3.14.22",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "docx": "^9.15.0",
    "dompurify": "3.4.17",
    "exceljs": "^4.4.0",
    "katex": "^0.18.2",
    "lucide-react": "1.61.0",
    "mdast-util-math": "file:patched-packages/mdast-util-math",
    "mermaid": "12.1.0",
    "micromark-extension-gfm-table": "file:patched-packages/micromark-extension-gfm-table",
    "micromark-extension-math": "file:patched-packages/micromark-extension-llm-math",
    "node-pty": "1.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.5.0",
    "ssf": "^0.11.2",
    "three": "0.186.1",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "draco3d": "1.5.7",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "linkedom": "^0.18.14",
    "meshoptimizer": "1.3.0",
    "tsc-rs": "0.8.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.0",
    "katex": "$katex",
    "dompurify": "3.4.17",
    "mdast-util-math": "$mdast-util-math",
    "micromark-extension-gfm-table": "$micromark-extension-gfm-table",
    "micromark-extension-math": "$micromark-extension-math",
    "image-size": "2.0.3"
  },
  "author": {
    "name": "Muster",
    "email": "hello@themuster.dev"
  },
  "homepage": "https://github.com/musterhq/muster-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/musterhq/muster-code.git"
  }
}
