#!/usr/bin/env node
/*
 * A stand-in for the system `ssh`, for the #147 SSH-workspace tests. It never opens a network connection: the "remote host"
 * is this machine, and the remote command runs under /bin/sh with HOME set to <state>/home. State lives in
 * $MUSTER_FAKE_SSH_ROOT:
 *   config.json      { aliases: { <alias>: { hostname, port, user } } }   what `ssh -G` reports
 *   host_key         the key line ("ssh-ed25519 AAAA...") this host offers
 *   user_known_hosts the user's own known_hosts, as `ssh -G` names it
 *   down / authfail  when present, the host is unreachable / refuses every key
 *   master           present while the multiplexed master connection is up
 *   log.jsonl        one line per invocation: { argv, kind, fresh }
 * Port forwards (`-O forward -L`) run a small TCP relay child whose pid is kept in fwd-<port>.pid until `-O cancel` or `-O exit`.
 */
'use strict';
const fs = require('node:fs'), path = require('node:path'), { spawn, spawnSync } = require('node:child_process'), net = require('node:net');
const root = process.env.MUSTER_FAKE_SSH_ROOT;
if (!root) { process.stderr.write('fake ssh: MUSTER_FAKE_SSH_ROOT is not set\n'); process.exit(255); }

// The relay child: `ssh --muster-fake-relay <localPort> <remotePort>`.
if (process.argv[2] === '--muster-fake-relay') {
  const [lp, rp] = [Number(process.argv[3]), Number(process.argv[4])];
  const server = net.createServer(sock => { const up = net.connect(rp, '127.0.0.1'); sock.pipe(up).pipe(sock); up.on('error', () => sock.destroy()); sock.on('error', () => up.destroy()); });
  server.listen(lp, '127.0.0.1', () => { fs.writeFileSync(path.join(root, `fwd-${lp}.ready`), ''); });
  return;
}

const WITH_VALUE = new Set(['-o', '-F', '-p', '-i', '-l', '-S', '-O', '-L', '-R', '-D', '-E', '-c', '-m', '-b', '-J', '-W', '-w', '-Q', '-B', '-e', '-I', '-P']);
const argv = process.argv.slice(2), opts = {}, flags = new Set(), lists = { L: [] };
let control, i = 0;
for (; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--') { i++; break; }
  if (!a.startsWith('-') || a === '-') break;
  if (WITH_VALUE.has(a)) {
    const v = argv[++i];
    if (a === '-o') { const at = v.indexOf('='); opts[v.slice(0, at).toLowerCase()] = v.slice(at + 1); }
    else if (a === '-O') control = v;
    else if (a === '-L') lists.L.push(v);
    else opts[a] = v;
  } else for (const c of a.slice(1)) flags.add(c);
}
const dest = argv[i], command = argv.slice(i + 1).join(' ');
const exists = name => fs.existsSync(path.join(root, name));
const read = (name, fallback = '') => { try { return fs.readFileSync(path.join(root, name), 'utf8'); } catch { return fallback; } };
const log = (kind, extra = {}) => fs.appendFileSync(path.join(root, 'log.jsonl'), JSON.stringify({ argv, kind, ...extra }) + '\n');
const die = (message, code = 255) => { process.stderr.write(message.endsWith('\n') ? message : `${message}\n`); process.exit(code); };

if (!dest) die('usage: ssh destination [command]');
if (dest.startsWith('-')) die(`ssh: illegal destination ${dest}`);
const config = JSON.parse(read('config.json', '{}')), alias = (config.aliases || {})[dest] || {};
const at = dest.lastIndexOf('@'), hostname = alias.hostname || (at >= 0 ? dest.slice(at + 1) : dest);
const port = Number(opts['-p'] || alias.port || 22), user = opts['-l'] || alias.user || (at >= 0 ? dest.slice(0, at) : 'me');

if (flags.has('G')) {
  log('config');
  process.stdout.write(`host ${dest}\nhostname ${hostname}\nport ${port}\nuser ${user}\nuserknownhostsfile ${path.join(root, 'user_known_hosts')}\n${alias.proxyjump ? `proxyjump ${alias.proxyjump}\n` : ''}`);
  process.exit(0);
}

const relayPids = () => fs.readdirSync(root).filter(n => /^fwd-\d+\.pid$/.test(n));
if (control) {
  log(`control:${control}`);
  if (control === 'check') { if (exists('master')) { process.stderr.write('Master running (pid=1)\n'); process.exit(0); } die('Control socket connect(/tmp/x): No such file or directory'); }
  if (control === 'exit') { for (const f of relayPids()) { try { process.kill(Number(read(f)), 'SIGTERM'); } catch {} fs.rmSync(path.join(root, f), { force: true }); } fs.rmSync(path.join(root, 'master'), { force: true }); process.stderr.write('Exit request sent.\n'); process.exit(0); }
  if (!exists('master')) die('Control socket connect(/tmp/x): No such file or directory');
  const spec = lists.L[0] || '', parts = spec.split(':'), lp = Number(parts[parts.length - 3]), rp = Number(parts[parts.length - 1]);
  if (control === 'forward') {
    const child = spawn(process.execPath, [__filename, '--muster-fake-relay', String(lp), String(rp)], { detached: true, stdio: 'ignore', env: process.env });
    child.unref(); fs.writeFileSync(path.join(root, `fwd-${lp}.pid`), String(child.pid));
    for (let n = 0; n < 200 && !exists(`fwd-${lp}.ready`); n++) spawnSync('sleep', ['0.02']);
    process.exit(0);
  }
  if (control === 'cancel') { try { process.kill(Number(read(`fwd-${lp}.pid`)), 'SIGTERM'); } catch {} fs.rmSync(path.join(root, `fwd-${lp}.pid`), { force: true }); fs.rmSync(path.join(root, `fwd-${lp}.ready`), { force: true }); process.exit(0); }
  die(`unknown control ${control}`);
}

// A command through an existing master needs no new connection, so nothing below (reachability, host key, keys) is checked again.
const fresh = !exists('master');
if (fresh) {
  if (exists('down')) { log('exec', { fresh, refused: 'down' }); die(`ssh: connect to host ${hostname} port ${port}: Connection refused`); }
  const name = port === 22 ? hostname : `[${hostname}]:${port}`, key = read('host_key').trim();
  const files = (opts.userknownhostsfile || '').match(/"[^"]*"|\S+/g) || [];
  const known = files.map(f => f.replace(/^"|"$/g, '')).flatMap(f => { try { return fs.readFileSync(f.replace(/^~/, process.env.HOME || ''), 'utf8').split('\n'); } catch { return []; } })
    .filter(l => l.split(' ')[0].split(',').includes(name));
  if ((opts.stricthostkeychecking || '').toLowerCase() !== 'yes') { log('exec', { fresh, refused: 'not-strict' }); die('fake ssh: the tests require StrictHostKeyChecking=yes'); }
  if (known.length && !known.some(l => l.split(' ').slice(1, 3).join(' ') === key)) { log('exec', { fresh, refused: 'changed' }); die('@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@\n@    WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED!     @\n@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@\nHost key verification failed.'); }
  if (!known.length) { log('exec', { fresh, refused: 'unknown' }); die(`No ED25519 host key is known for ${name} and you have requested strict checking.\r\nHost key verification failed.`); }
  if (exists('authfail')) { log('exec', { fresh, refused: 'auth' }); die(`${user}@${hostname}: Permission denied (publickey,password).`); }
  if ((opts.batchmode || '').toLowerCase() !== 'yes') die('fake ssh: the tests require BatchMode=yes');
  if ((opts.controlmaster || '').toLowerCase() === 'auto') fs.writeFileSync(path.join(root, 'master'), '');
}
log('exec', { fresh, tty: flags.has('t') });
const home = path.join(root, 'home'); fs.mkdirSync(home, { recursive: true });
const child = spawn('/bin/sh', ['-c', command || 'exec /bin/sh -l'], { cwd: home, stdio: 'inherit', env: { PATH: process.env.PATH, HOME: home, SHELL: '/bin/sh', USER: user, LANG: 'C', TERM: process.env.TERM || 'dumb', MUSTER_FAKE_SSH_ROOT: root } });
child.on('exit', (code, signal) => process.exit(signal ? 255 : code ?? 255));
