<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PER-09: hardened-runtime entitlements for a Developer ID + notarized build.
     Electron's V8 needs JIT; node-pty's native addon and spawn-helper are signed with
     the same identity, so library validation stays on. No network server, camera or
     Apple Events entitlements are requested; the microphone is for dictation (#840). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- #840: dictation records from the microphone while you dictate (the hardened runtime blocks it otherwise). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
