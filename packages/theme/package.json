{
  "name": "@muster-code/theme",
  "displayName": "Muster Themes",
  "description": "Muster Dark \u2014 the Muster Code default theme.",
  "version": "0.1.0",
  "publisher": "muster",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.126.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Muster Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/muster-dark-color-theme.json"
      },
      {
        "label": "Muster Light",
        "uiTheme": "vs",
        "path": "./themes/muster-light-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Muster Dark",
      "workbench.activityBar.location": "top",
      "window.titleBarStyle": "custom",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": true,
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": true,
      "workbench.statusBar.visible": true,
      "chat.commandCenter.enabled": false,
      "editor.fontSize": 13,
      "editor.lineHeight": 20,
      "editor.minimap.enabled": false,
      "editor.inlineSuggest.enabled": true,
      "explorer.compactFolders": false,
      "workbench.editor.empty.hint": "text",
      "diffEditor.renderSideBySide": false,
      "diffEditor.ignoreTrimWhitespace": false,
      "chat.disableAIFeatures": true,
      "workbench.activityBar.autoHide": true
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist-ext',{recursive:true});require('fs').cpSync('themes','dist-ext/themes',{recursive:true});const p=require('./package.json');delete p.scripts;require('fs').writeFileSync('dist-ext/package.json',JSON.stringify(p,null,2))\""
  }
}
