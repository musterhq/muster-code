  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#F0F0F066", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#FC6B83" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#70B489" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#F1B467" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"], "settings": { "foreground": "#7BAFE9" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#9386F2" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable entity.name"], "settings": { "foreground": "#F0F0F0" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#F0F0F0CC" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#FC6B83" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#F1B467" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#F0F0F0B3" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#B0B8F8" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#F0F0F0", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#B0B8F8" } },
    { "scope": ["invalid"], "settings": { "foreground": "#FC6B83" } }
  ]
}
